<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.rheeger.ppa.maintain-nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PPA_PYTHON__</string>
		<string>__PPA_REPO__/archive_scripts/ppa-maintain-nightly.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__PPA_REPO__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PPA_ENRICHMENT_MODEL</key>
		<string>openai:gpt-4o-mini</string>
		<key>PATH</key>
		<string>__PPA_TOOL_PATH__</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>2</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__PPA_REPO__/logs/ppa-maintain-nightly-launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__PPA_REPO__/logs/ppa-maintain-nightly-launchd.err.log</string>
</dict>
</plist>
