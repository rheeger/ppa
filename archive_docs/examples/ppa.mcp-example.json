{
  "_comment": "Development example for a local stdio client. Paths describe a disposable test instance. Requires the native archive_crate extension. Hash embeddings are for fixture tests.",
  "mcpServers": {
    "ppa-local": {
      "command": "/tmp/ppa-independent/venv/bin/ppa",
      "args": [
        "serve"
      ],
      "env": {
        "PPA_INDEX_DSN": "postgresql://archive:archive@127.0.0.1:55432/archive",
        "PPA_INDEX_SCHEMA": "ppa_fixture",
        "PPA_PATH": "/tmp/ppa-independent/vault",
        "PPA_EMBEDDING_PROVIDER": "hash",
        "PPA_MCP_TOOL_PROFILE": "read-only"
      }
    }
  }
}
